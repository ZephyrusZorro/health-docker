APP_NAME="Nishat HMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nishat_hms
DB_USERNAME=nishat
DB_PASSWORD=nishat_secret

# --- Session / Cache / Queue (Redis) -----------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Broadcasting / WebSockets (Reverb) --------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=nishat
REVERB_APP_KEY=nishat-key
REVERB_APP_SECRET=nishat-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# --- S3-compatible storage (MinIO in dev) ------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nishat
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@nishat.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum / CORS ----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# --- HMS-specific settings ---------------------------------------------------
HMS_UHID_PREFIX=NH
HMS_TOKEN_PREFIX=T
HMS_DEFAULT_CURRENCY=INR
HMS_DISCOUNT_APPROVAL_THRESHOLD=20
HMS_BED_CLEANING_MINUTES=30
HMS_APPOINTMENT_REMINDER_HOURS=24,2
HMS_MFA_ENFORCED=false

# --- Integrations (stubs) ----------------------------------------------------
SMS_DRIVER=log
WHATSAPP_DRIVER=log
PAYMENT_GATEWAY=stub
CHATBOT_PROVIDER=stub
